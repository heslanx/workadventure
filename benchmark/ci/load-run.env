# What benchmark/ci/run-load.sh runs. A value already in the environment wins over the one here.

# Bots at each step of the staircase, in this order. Every step gets a fresh stack.
LEVELS="${LEVELS:-300 500 700 1000}"
# Runs of the whole staircase, interleaved: every level once, then every level again. The scenarios of a level run
# side by side.
REPEAT="${REPEAT:-1}"
# budget-off: the code's defaults. budget-on: PUSHER_VIEWER_BUDGET_ENABLED=true (150 full-rate peers, 400 at most).
SCENARIOS="${SCENARIOS:-budget-off budget-on}"

# The population of every staircase level: a fifth of the bots walk and stop, the rest stand; each has a browser-sized
# viewport and watches the world space, as a real client does.
GENERATOR_FLAGS="${GENERATOR_FLAGS:---move-hz=5 --viewport=browser --pattern=walk-stop --moving-fraction=0.2 --world-space=1}"
PROCESSES="${PROCESSES:-4}"
RAMP_SECONDS="${RAMP_SECONDS:-60}"
DURATION_SECONDS="${DURATION_SECONDS:-240}"
STEADY_WINDOW="${STEADY_WINDOW:-120}"

# One more level with the defaults of the code and a CPU profile of the pusher inside the steady window. 0 skips it.
PROFILE_LEVEL="${PROFILE_LEVEL:-1000}"

# The procedure of the 2026-11-17 workstation baseline (every bot walks an ellipse, one generator process, ramp 20 s,
# 60 s in all, statistics over the whole run), to tell this host from that one. 0 skips it.
CALIBRATION_LEVEL="${CALIBRATION_LEVEL:-300}"

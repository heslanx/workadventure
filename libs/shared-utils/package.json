{
  "name": "@workadventure/shared-utils",
  "version": "1.0.0",
  "description": "Map Editor commands types",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint-fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "precommit": "lint-staged",
    "pretty": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "pretty-check": "prettier --check 'src/**/*.{ts,tsx}' 'tests/**/*.{ts,tsx}'",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:cov": "vitest run --coverage",
    "test:debug": "NODE_OPTIONS='--loader tsx' node --inspect-brk -r tsconfig-paths/register node_modules/.bin/vitest --runInBand",
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  },
  "author": "WorkAdventure",
  "license": "ISC",
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.219.0",
    "@opentelemetry/exporter-logs-otlp-proto": "0.219.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.219.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.219.0",
    "@opentelemetry/instrumentation": "0.219.0",
    "@opentelemetry/instrumentation-express": "0.62.0",
    "@opentelemetry/instrumentation-grpc": "0.219.0",
    "@opentelemetry/instrumentation-http": "0.219.0",
    "@opentelemetry/instrumentation-redis": "0.67.0",
    "@opentelemetry/instrumentation-runtime-node": "0.26.0",
    "@opentelemetry/instrumentation-undici": "0.24.0",
    "@opentelemetry/resources": "2.8.0",
    "@opentelemetry/sdk-logs": "0.219.0",
    "@opentelemetry/sdk-metrics": "2.8.0",
    "@opentelemetry/sdk-node": "0.219.0",
    "@opentelemetry/sdk-trace-base": "2.8.0",
    "@workadventure/map-editor": "1.0.0",
    "@workadventure/messages": "1.0.0",
    "@workadventure/tiled-map-type-guard": "^2.1.2",
    "axios": "^1.16.1",
    "catch-unknown": "^2.0.0",
    "debug": "^4.4.3",
    "posthog-node": "^5.70.0",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/debug": "^4.1.13",
    "@types/node": "^24.19.2",
    "@workadventure/eslint-config": "1.0.0",
    "eslint": "^9.39.4",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  },
  "files": [
    "src"
  ],
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}

{
  "$schema": "./taxonomy.schema.json",
  "version": 1,
  "about": "The map editor's object list of the HQ office: one category per piece, in the order the editor shows them (it sorts the tags alphabetically, so this order is checked, not chosen), how each source's pieces map to a category, the suffixes of derived pieces, renamed pieces and pieces left out as exact duplicates. Names in 'renamed', 'left_out' and 'same_as' are the source's names, before any rename. Read by taxonomy.py; checked by test_taxonomy.py.",
  "categories": [
    {"id": "armazenamento", "name": "Armazenamento", "about": "Cabinets, shelves, bookcases, filing cabinets, lockers, chests and the rows of books that go on shelves"},
    {"id": "cadeiras", "name": "Cadeiras e bancos", "about": "Chairs, stools and benches"},
    {"id": "comidas", "name": "Comidas e bebidas", "about": "Food and drinks, with the cups, mugs, bottles and pots that hold them"},
    {"id": "cozinha", "name": "Cozinha e café", "about": "Kitchen counters and shelves, fridges, vending machines, water coolers, coffee machines and bar counters"},
    {"id": "parede", "name": "Decoração de parede", "about": "What hangs on a wall for decoration: pictures, posters, maps, mirrors, clocks, wall hangings, acoustic panels"},
    {"id": "divisorias", "name": "Divisórias e biombos", "about": "Partitions, screens, freestanding panels and barriers"},
    {"id": "escritorio", "name": "Escritório e papelaria", "about": "Papers, notebooks, books, desk phones, stationery, whiteboards, notice boards, lecterns, backpacks and desk photo frames"},
    {"id": "fantasia", "name": "Estilo fantasia (LPC)", "about": "The LPC sheets: another drawing style (fantasy RPG), kept apart so it is never mixed with the office's pieces by accident"},
    {"id": "exterior", "name": "Exterior e jardim", "about": "Trees, garden plants, fountains, grills, fire pits and what stands outside"},
    {"id": "festas", "name": "Festas e datas", "about": "Seasonal and festive pieces: holidays, flags, bunting"},
    {"id": "jogos", "name": "Jogos e lazer", "about": "Arcade machines, game tables, balls, sports gear, instruments, record players and the interactive games"},
    {"id": "luminarias", "name": "Luminárias", "about": "Desk, floor, pendant and wall lamps, string lights, lanterns and neon signs"},
    {"id": "mesas", "name": "Mesas", "about": "Desks, work tables and their modular parts, meeting, dining, side and coffee tables"},
    {"id": "decoracao", "name": "Objetos decorativos", "about": "Decoration that stands on the floor or on furniture: vases, statues, aquariums, toys, cushions, throws"},
    {"id": "arquitetura", "name": "Paredes, portas e janelas", "about": "Walls, doors and windows placed as pieces"},
    {"id": "marca", "name": "Peças da marca", "about": "Pieces that show the Koncluí identity (the logotype, the K, Koru) and the series of brand pictures (brand, Koru, the restaurants Koncluí serves)"},
    {"id": "plantas", "name": "Plantas", "about": "Potted plants for floor, desk and wall, planters and plant stands"},
    {"id": "sofas", "name": "Sofás e poltronas", "about": "Sofas, sofa modules and armchairs"},
    {"id": "tapetes", "name": "Tapetes e pisos", "about": "Rugs, carpets and floor tiles placed as pieces"},
    {"id": "tecnologia", "name": "Tecnologia e telas", "about": "Computers, monitors, TVs, tablets, printers, cameras, microphones, headphones and machines"},
    {"id": "utilidades", "name": "Utilidades e segurança", "about": "Air conditioning, heaters and fans, bins, fire extinguishers and emergency buttons"}
  ],

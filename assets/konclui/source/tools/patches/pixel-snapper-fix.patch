+    #[test]
+    fn expected_cell_rejects_a_grid_that_does_not_fit() {
+        // 24x24 art enlarged 8.5 times is 204 pixels: no whole number of 32 pixel cells
+        let art = sprite(24, 24, 3);
+        let big = enlarge(&art, 8.5, 8.5);
+        let config = Config {
+            expect_cell: Some(32),
+            ..Default::default()
+        };
+        let error = snap(&big, config).err().unwrap();
+        assert!(
+            matches!(error, PixelSnapperError::Unresolved(_)),
+            "{}",
+            error
+        );
+
+        // The same expectation accepts art that is a multiple of the cell
+        let art = sprite(64, 32, 3);
+        let config = Config {
+            expect_cell: Some(32),
+            ..Default::default()
+        };
+        let (out, _) = snap(&enlarge(&art, 8.0, 8.0), config).unwrap();
+        assert_eq!(out.dimensions(), (64, 32));
+    }
+
+    #[test]
+    fn walker_does_not_skip_pixels_at_small_steps() {
+        let config = Config::default();
+        // A boundary at every position: the grid is the pixel grid
+        let mut profile = vec![10.0; 40];
+        profile[0] = 0.0;
+        let cuts = walk(&profile, 1.0, 0, 40, &config).unwrap();
+        assert_eq!(cuts, identity_cuts(40));
+
+        // Boundaries every two pixels
+        let profile: Vec<f64> = (0..40)
+            .map(|i| if i % 2 == 0 { 10.0 } else { 0.0 })
+            .collect();
+        let cuts = walk(&profile, 2.0, 0, 40, &config).unwrap();
+        assert!(cuts.windows(2).all(|w| w[1] - w[0] == 2), "{:?}", cuts);
+    }
+
+    #[test]
+    fn walker_folds_a_crop_remnant_into_its_neighbour() {
+        let config = Config::default();
+        // Boundaries every 8 pixels starting at 8, and a 1 pixel remnant at the end
+        let profile: Vec<f64> = (0..65)
+            .map(|i| if i % 8 == 0 { 10.0 } else { 0.0 })
+            .collect();
+        let cuts = walk(&profile, 8.0, 0, 65, &config).unwrap();
+        assert_eq!(cuts, vec![0, 8, 16, 24, 32, 40, 48, 56, 65]);
+    }
+
+    #[test]
+    fn transparent_pixels_cannot_outvote_the_opaque_majority_or_the_reverse() {
+        let mut cell = RgbaImage::new(8, 8);
+        for (i, p) in cell.pixels_mut().enumerate() {
+            *p = if i < 40 {
+                // Transparent, with a different hidden colour each time
+                Rgba([i as u8, (i * 3) as u8, 7, 0])
+            } else {
+                Rgba([200, 10, 10, 255])
+            };
+        }
+        let out = resample(&cell, &[0, 8], &[0, 8]).unwrap();
+        assert_eq!(out.get_pixel(0, 0)[3], 0);
+
+        // And partial alpha is its own class
+        let shadow = RgbaImage::from_pixel(8, 8, Rgba([0, 0, 0, 100]));
+        let out = resample(&shadow, &[0, 8], &[0, 8]).unwrap();
+        assert_eq!(out.get_pixel(0, 0).0, [0, 0, 0, 100]);
+    }

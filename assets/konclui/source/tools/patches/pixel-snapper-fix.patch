+    /// Bilinear enlargement of premultiplied colour and alpha, as an image resizer does it:
+    /// every cell is a ramp between the values at the centres of its source pixel and the next.
+    fn enlarge_bilinear(img: &RgbaImage, scale: f64) -> RgbaImage {
+        let (w, h) = (img.width() as i64, img.height() as i64);
+        let premult = |x: i64, y: i64| -> [f64; 4] {
+            let p = img.get_pixel(x.clamp(0, w - 1) as u32, y.clamp(0, h - 1) as u32);
+            let a = p[3] as f64 / 255.0;
+            [
+                p[0] as f64 * a,
+                p[1] as f64 * a,
+                p[2] as f64 * a,
+                p[3] as f64,
+            ]

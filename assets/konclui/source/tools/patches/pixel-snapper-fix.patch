+            let big = enlarge_bilinear(&art, scale);
+            let (out, processed) = snap(&big, Config::default()).unwrap();
+            assert_eq!(
+                out.dimensions(),
+                (40, 48),
+                "scale {}: {}",
+                scale,
+                processed.detail
+            );
+            let same = agreement(&out, &art);
+            assert!(same > 0.9, "scale {}: agreement {}", scale, same);
+            assert!(out.pixels().all(|p| p[3] == 0 || p[3] == 255));
+        }
+    }
+
+    #[test]
+    fn pixel_size_override_has_no_extra_cell() {
+        let art = sprite(32, 32, 2);
+        let messy = blur_and_noise(&enlarge(&art, 8.0, 8.0), 2);
+        let config = Config {
+            pixel_size_override: Some(8.0),
+            ..Default::default()
+        };
+        let (out, processed) = snap(&messy, config).unwrap();
+        assert_eq!(out.dimensions(), (32, 32));
+        assert_eq!(processed.pixel_size_source, "override");
+    }
+
+    #[test]
+    fn pixel_size_one_keeps_the_picture() {
+        let art = colorful_sprite(32, 32, 6);
+        let config = Config {
+            pixel_size_override: Some(1.0),
+            ..Default::default()

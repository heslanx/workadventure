+    #[test]
+    fn picture_without_structure_is_reported_not_guessed() {
+        let flat = RgbaImage::from_pixel(64, 64, Rgba([120, 120, 120, 255]));
+        let error = snap(&flat, Config::default()).err().unwrap();
+        assert!(
+            matches!(error, PixelSnapperError::Unresolved(_)),
+            "{}",
+            error
+        );
+
+        let gradient =
+            RgbaImage::from_fn(64, 64, |x, y| Rgba([(x * 3) as u8, (y * 3) as u8, 90, 255]));
+        let error = snap(&gradient, Config::default()).err().unwrap();
+        assert!(
+            matches!(error, PixelSnapperError::Unresolved(_)),
+            "{}",
+            error
+        );
+        assert!(error.to_string().contains("--pixel-size"));
+    }

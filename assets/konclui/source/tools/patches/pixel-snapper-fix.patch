+                    unpremult(acc[1]).round().clamp(0.0, 255.0) as u8,
+                    unpremult(acc[2]).round().clamp(0.0, 255.0) as u8,
+                    alpha.round().clamp(0.0, 255.0) as u8,
+                ])

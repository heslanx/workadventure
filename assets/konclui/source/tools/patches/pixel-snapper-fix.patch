+
+    #[test]
+    fn crop_and_padding_do_not_change_the_cell_count() {
+        let art = sprite(32, 32, 4);
+        let big = enlarge(&art, 8.0, 8.0);
+        for crop in 1..=3 {
+            let cropped =
+                image::imageops::crop_imm(&big, crop, crop, 256 - crop, 256 - crop).to_image();
+            let (out, _) = snap(&cropped, Config::default()).unwrap();
+            assert_eq!(out.dimensions(), (32, 32), "crop {}", crop);
+        }
+        for pad in 1..=3u32 {
+            let padded = RgbaImage::from_fn(256 + pad, 256 + pad, |x, y| {
+                *big.get_pixel(
+                    x.saturating_sub(pad).min(255),
+                    y.saturating_sub(pad).min(255),
+                )
+            });
+            let (out, _) = snap(&padded, Config::default()).unwrap();
+            assert_eq!(out.dimensions(), (32, 32), "pad {}", pad);
+        }
+    }
+
+    #[test]
+    fn different_horizontal_and_vertical_scales_are_kept_apart() {
+        let art = sprite(32, 32, 8);
+        let big = enlarge(&art, 8.0, 9.0);
+        let (out, _) = snap(&big, Config::default()).unwrap();
+        assert_eq!(out.dimensions(), (32, 32));
+        assert!(agreement(&out, &art) > 0.98);

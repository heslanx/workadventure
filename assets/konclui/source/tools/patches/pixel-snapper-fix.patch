+    /// Pixel art made of runs of one to a few pixels, one-pixel details and a transparent
+    /// background, with binary alpha.
+    fn sprite(width: u32, height: u32, seed: u64) -> RgbaImage {
+        let mut rng = ChaCha8Rng::seed_from_u64(seed);
+        let mut img = RgbaImage::new(width, height);
+        for y in 0..height {
+            for x in 0..width {
+                let roll = rng.gen_range(0..100);
+                let pixel = if roll < 45 && x > 0 {
+                    *img.get_pixel(x - 1, y)
+                } else if roll < 75 && y > 0 {
+                    *img.get_pixel(x, y - 1)
+                } else if rng.gen_range(0..6) == 0 {
+                    Rgba([0, 0, 0, 0])
+                } else {
+                    let c = PALETTE[rng.gen_range(0..PALETTE.len())];
+                    Rgba([c[0], c[1], c[2], 255])
+                };
+                img.put_pixel(x, y, pixel);
+            }
+        }
+        img
+    }

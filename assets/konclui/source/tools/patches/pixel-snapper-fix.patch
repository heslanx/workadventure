+    #[test]
+    fn cli_parses_the_new_options() {
+        let args: Vec<String> = ["in.png", "out.png", "32", "--expect-cell", "32"]
+            .iter()
+            .map(|s| s.to_string())
+            .collect();
+        let CliCommand::Run(config) = parse_cli_args(&args).unwrap() else {
+            panic!("expected a processing command");
+        };
+        assert_eq!(config.expect_cell, Some(32));
+        assert_eq!(config.k_colors, 32);
+        assert!(config.k_colors_explicit);
+
+        let args: Vec<String> = ["in.png", "out.png"]
+            .iter()
+            .map(|s| s.to_string())
+            .collect();
+        let CliCommand::Run(config) = parse_cli_args(&args).unwrap() else {
+            panic!("expected a processing command");
+        };
+        assert!(!config.k_colors_explicit);
+
+        let args: Vec<String> = ["in.png", "out.png", "--expect-cell", "0"]
+            .iter()
+            .map(|s| s.to_string())
+            .collect();
+        assert!(parse_cli_args(&args).is_err());
+    }

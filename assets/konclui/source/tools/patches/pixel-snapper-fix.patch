+    /// A 1-2-1 blur of premultiplied colour and alpha, then Gaussian noise on the colour.
+    fn blur_and_noise(img: &RgbaImage, seed: u64) -> RgbaImage {
+        let mut rng = ChaCha8Rng::seed_from_u64(seed);
+        let noise = Normal::new(0.0, 4.0).unwrap();
+        let (w, h) = img.dimensions();
+        let premult = |x: i64, y: i64| -> [f64; 4] {
+            let p = img.get_pixel(
+                x.clamp(0, w as i64 - 1) as u32,
+                y.clamp(0, h as i64 - 1) as u32,
+            );
+            let a = p[3] as f64 / 255.0;
+            [
+                p[0] as f64 * a,
+                p[1] as f64 * a,
+                p[2] as f64 * a,
+                p[3] as f64,
+            ]
+        };
+        let kernel = [(-1i64, 1.0), (0, 2.0), (1, 1.0)];
+        RgbaImage::from_fn(w, h, |x, y| {
+            let mut acc = [0.0; 4];
+            for &(dy, wy) in &kernel {
+                for &(dx, wx) in &kernel {
+                    let p = premult(x as i64 + dx, y as i64 + dy);
+                    for c in 0..4 {
+                        acc[c] += p[c] * wx * wy / 16.0;
+                    }
+                }
+            }
+            let alpha = acc[3];
+            let unpremult = |v: f64| if alpha > 0.0 { v * 255.0 / alpha } else { 0.0 };
+            let mut channel = |v: f64| {
+                (unpremult(v) + noise.sample(&mut rng))
+                    .round()
+                    .clamp(0.0, 255.0) as u8
+            };
+            Rgba([
+                channel(acc[0]),
+                channel(acc[1]),
+                channel(acc[2]),
+                alpha.round().clamp(0.0, 255.0) as u8,
+            ])
+        })

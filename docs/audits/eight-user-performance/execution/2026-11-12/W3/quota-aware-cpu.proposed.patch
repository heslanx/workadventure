+function positiveRatio(numerator: string, denominator: string): number | undefined {
+    const quota = Number(numerator);
+    const period = Number(denominator);
+    if (!Number.isFinite(quota) || !Number.isFinite(period) || quota <= 0 || period <= 0) {
+        return undefined;
+    }
+    return quota / period;
+}
+
+/**
+ * Parses cgroup v2 `cpu.max` ("<quota> <period>" or "max <period>") into cores, or undefined when unlimited.
+ */
+export function parseCgroupV2CpuMax(content: string): number | undefined {
+    const [quota, period = "100000"] = content.trim().split(/\s+/);
+    if (quota === undefined || quota === "max") {
+        return undefined;
+    }
+    return positiveRatio(quota, period);
+}
+
+/**
+ * Parses cgroup v1 `cpu.cfs_quota_us` / `cpu.cfs_period_us` into cores, or undefined when unlimited (-1).
+ */
+export function parseCgroupV1CfsQuota(quotaUs: string, periodUs: string): number | undefined {
+    return positiveRatio(quotaUs.trim(), periodUs.trim());
+}
+
+function readCgroupCpuQuotaCores(): number | undefined {
+    if (existsSync("/sys/fs/cgroup/cpu.max")) {
+        return parseCgroupV2CpuMax(readFileSync("/sys/fs/cgroup/cpu.max", "utf8"));
+    }
+    if (existsSync("/sys/fs/cgroup/cpu/cpu.cfs_quota_us") && existsSync("/sys/fs/cgroup/cpu/cpu.cfs_period_us")) {
+        return parseCgroupV1CfsQuota(
+            readFileSync("/sys/fs/cgroup/cpu/cpu.cfs_quota_us", "utf8"),
+            readFileSync("/sys/fs/cgroup/cpu/cpu.cfs_period_us", "utf8"),
+        );
+    }
+    return undefined;
+}
+
+/**
+ * The percentage stays relative to one core because the event loop saturates at one core, whatever the quota above it.
+ * A quota below one core lowers the ceiling: otherwise a fully throttled process (e.g. 0.65 CPU) reports 65 % and never
+ * crosses the default 80 % threshold.
+ */
+export function cpuCapacityCores(quotaCores: number | undefined): number {
+    return quotaCores === undefined ? 1 : Math.min(1, quotaCores);
+}
+
+export function computeCpuPercent(cpuTimeMs: number, elapsedMs: number, capacityCores: number): number {
+    if (elapsedMs <= 0 || capacityCores <= 0) {
+        return 0;
+    }
+    return Math.round((100 * cpuTimeMs) / (elapsedMs * capacityCores));
+}

diff -ruN a/back/tests/CpuTracker.test.ts b/back/tests/CpuTracker.test.ts
--- a/back/tests/CpuTracker.test.ts	1970-01-01 01:00:00
+++ b/back/tests/CpuTracker.test.ts	2026-11-12 01:38:32
@@ -0,0 +1,81 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+
+vi.mock("../src/Enum/EnvironmentVariable", () => ({ CPU_OVERHEAT_THRESHOLD: 80 }));
+
+// Synthetic clock: each 100 ms tick credits the process `coresUsed * 100 ms` of CPU time.
+async function trackerConsuming(coresUsed: number, capacityCores: number) {
+    vi.resetModules();
+    let nowNs = 0n;
+    let cpuUs = 0;
+    vi.spyOn(process.hrtime, "bigint").mockImplementation(() => nowNs);
+    vi.spyOn(process, "cpuUsage").mockImplementation((previous?: NodeJS.CpuUsage) =>
+        previous ? { user: cpuUs - previous.user, system: 0 - previous.system } : { user: cpuUs, system: 0 },
+    );
+    vi.useFakeTimers({ toFake: ["setInterval"] });
+    const { CpuTracker } = await import("../src/Services/CpuTracker");
+    const tracker = new CpuTracker(capacityCores);
+    for (let tick = 0; tick < 5; tick++) {
+        nowNs += 100_000_000n;
+        cpuUs += coresUsed * 100_000;
+        vi.advanceTimersByTime(100);
+    }
+    return tracker;
+}
+
+describe("CpuTracker", () => {
+    afterEach(() => {
+        vi.useRealTimers();
+        vi.restoreAllMocks();
+    });
+
+    describe("cgroup quota parsing", () => {
+        it("reads a cgroup v2 quota as cores and treats max as unlimited", async () => {
+            const { parseCgroupV2CpuMax } = await import("../src/Services/CpuTracker");
+            expect(parseCgroupV2CpuMax("65000 100000\n")).toBe(0.65);
+            expect(parseCgroupV2CpuMax("200000 100000")).toBe(2);
+            expect(parseCgroupV2CpuMax("max 100000")).toBeUndefined();
+            expect(parseCgroupV2CpuMax("garbage")).toBeUndefined();
+        });
+
+        it("reads a cgroup v1 quota as cores and treats -1 as unlimited", async () => {
+            const { parseCgroupV1CfsQuota } = await import("../src/Services/CpuTracker");
+            expect(parseCgroupV1CfsQuota("50000\n", "100000\n")).toBe(0.5);
+            expect(parseCgroupV1CfsQuota("-1", "100000")).toBeUndefined();
+        });
+    });
+
+    describe("capacity", () => {
+        it("caps the capacity at one core and lowers it to a quota below one core", async () => {
+            const { cpuCapacityCores } = await import("../src/Services/CpuTracker");
+            expect(cpuCapacityCores(undefined)).toBe(1);
+            expect(cpuCapacityCores(0.65)).toBe(0.65);
+            expect(cpuCapacityCores(2)).toBe(1);
+        });
+
+        it("reports a fully used 0.65-core quota as 100 %, against 65 % relative to one core", async () => {
+            const { computeCpuPercent } = await import("../src/Services/CpuTracker");
+            expect(computeCpuPercent(65, 100, 0.65)).toBe(100);
+            expect(computeCpuPercent(65, 100, 1)).toBe(65);
+        });
+    });
+
+    describe("overheat", () => {
+        it("overheats when the process fully consumes a quota below one core", async () => {
+            const tracker = await trackerConsuming(0.65, 0.65);
+            expect(tracker.getCpuPercent()).toBe(100);
+            expect(tracker.isOverHeating()).toBe(true);
+        });
+
+        it("does not overheat at 60 % of a 0.65-core quota", async () => {
+            const tracker = await trackerConsuming(0.39, 0.65);
+            expect(tracker.getCpuPercent()).toBe(60);
+            expect(tracker.isOverHeating()).toBe(false);
+        });
+
+        it("keeps the one-core reference above one core: a saturated event loop overheats in a 2-core quota", async () => {
+            const tracker = await trackerConsuming(1, 1);
+            expect(tracker.getCpuPercent()).toBe(100);
+            expect(tracker.isOverHeating()).toBe(true);
+        });
+    });
+});

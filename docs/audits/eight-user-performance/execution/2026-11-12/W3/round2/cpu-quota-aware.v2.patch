diff --git a/back/src/Services/QuotaAwareCpuTracker.ts b/back/src/Services/QuotaAwareCpuTracker.ts
new file mode 100644
index 0000000..94518c6
--- /dev/null
+++ b/back/src/Services/QuotaAwareCpuTracker.ts
@@ -0,0 +1,211 @@
+import { readFileSync } from "node:fs";
+import { asError } from "catch-unknown";
+import { CPU_OVERHEAT_THRESHOLD } from "../Enum/EnvironmentVariable";
+
+const PROC_SELF_CGROUP = "/proc/self/cgroup";
+const CGROUP_ROOT = "/sys/fs/cgroup";
+const CGROUP_V2_CPU_MAX = "cpu.max";
+const CGROUP_V1_CFS_QUOTA_US = "/sys/fs/cgroup/cpu/cpu.cfs_quota_us";
+const CGROUP_V1_CFS_PERIOD_US = "/sys/fs/cgroup/cpu/cpu.cfs_period_us";
+
+/**
+ * Returns the content of a file, or undefined when it does not exist or cannot be read.
+ */
+export type ReadOptionalFile = (path: string) => string | undefined;
+
+/**
+ * The CPU capacity the percentage is relative to, and where it comes from (logged at start).
+ */
+export interface CpuCapacity {
+    cores: number;
+    source: string;
+}
+
+function secNSec2ms(secNSec: Array<number> | number) {
+    if (Array.isArray(secNSec)) {
+        return secNSec[0] * 1000 + secNSec[1] / 1000000;
+    }
+    return secNSec / 1000;
+}
+
+function quotaToCores(quotaUs: string, periodUs: string): number | undefined {
+    if (!/^\d+$/.test(quotaUs) || !/^\d+$/.test(periodUs)) {
+        return undefined;
+    }
+    const quota = Number(quotaUs);
+    const period = Number(periodUs);
+    if (quota <= 0 || period <= 0) {
+        return undefined;
+    }
+    return quota / period;
+}
+
+/**
+ * Parses cgroup v2 `cpu.max` ("<quota> <period>") into cores.
+ * Returns undefined when the quota is unlimited ("max <period>") or the content is malformed.
+ */
+export function parseCgroupV2CpuMax(content: string): number | undefined {
+    const fields = /^(\S+)\s+(\S+)$/.exec(content.trim());
+    if (fields === null) {
+        return undefined;
+    }
+    return quotaToCores(fields[1], fields[2]);
+}
+
+/**
+ * Parses cgroup v1 `cpu.cfs_quota_us` and `cpu.cfs_period_us` into cores.
+ * Returns undefined when the quota is unlimited (-1) or either content is malformed.
+ */
+export function parseCgroupV1CfsQuota(quotaContent: string, periodContent: string): number | undefined {
+    return quotaToCores(quotaContent.trim(), periodContent.trim());
+}
+
+/**
+ * Parses `/proc/self/cgroup` and returns the cgroup v2 path of the process ("0::<path>").
+ * Returns undefined when there is no cgroup v2 entry or the path is not a plain absolute path.
+ */
+export function parseCgroupV2Path(content: string): string | undefined {
+    const line = content.split("\n").find((entry) => entry.startsWith("0::"));
+    const path = line?.slice("0::".length).trim();
+    if (path === undefined || !path.startsWith("/") || path.split("/").includes("..")) {
+        return undefined;
+    }
+    return path;
+}
+
+function isUnlimitedQuota(content: string): boolean {
+    return /^(max\s+\d+|-1)$/.test(content.trim());
+}
+
+function warnMalformed(path: string, content: string): void {
+    console.warn(`Ignoring malformed cgroup CPU quota in ${path}: ${JSON.stringify(content)}`);
+}
+
+function readCgroupV2Quota(readFile: ReadOptionalFile, path: string): CpuCapacity | "absent" | undefined {
+    const content = readFile(path);
+    if (content === undefined) {
+        return "absent";
+    }
+    const cores = parseCgroupV2CpuMax(content);
+    if (cores === undefined && !isUnlimitedQuota(content)) {
+        warnMalformed(path, content);
+    }
+    return cores === undefined ? undefined : { cores, source: `cgroup v2 ${path}` };
+}
+
+/**
+ * Reads the CPU quota of the current cgroup in cores: cgroup v2 first (the path of the process from
+ * `/proc/self/cgroup`, then the root, which is the container view with a private cgroup namespace), then cgroup v1.
+ * Returns undefined when no quota applies (no cgroup files, unlimited quota or malformed content).
+ */
+export function readCgroupCpuQuota(readFile: ReadOptionalFile): CpuCapacity | undefined {
+    const procCgroup = readFile(PROC_SELF_CGROUP);
+    const ownPath = procCgroup === undefined ? undefined : parseCgroupV2Path(procCgroup);
+    const v2Paths = [`${CGROUP_ROOT}/${CGROUP_V2_CPU_MAX}`];
+    if (ownPath !== undefined && ownPath !== "/") {
+        v2Paths.unshift(`${CGROUP_ROOT}${ownPath}/${CGROUP_V2_CPU_MAX}`);
+    }
+    for (const path of v2Paths) {
+        const quota = readCgroupV2Quota(readFile, path);
+        if (quota !== "absent") {
+            return quota;
+        }
+    }
+    const quota = readFile(CGROUP_V1_CFS_QUOTA_US);
+    const period = readFile(CGROUP_V1_CFS_PERIOD_US);
+    if (quota === undefined || period === undefined) {
+        return undefined;
+    }
+    const cores = parseCgroupV1CfsQuota(quota, period);
+    if (cores === undefined && !isUnlimitedQuota(quota)) {
+        warnMalformed(CGROUP_V1_CFS_QUOTA_US, `${quota.trim()} / ${period.trim()}`);
+    }
+    return cores === undefined ? undefined : { cores, source: `cgroup v1 ${CGROUP_V1_CFS_QUOTA_US}` };
+}
+
+/**
+ * Returns the cores reported by readCgroupCpuQuota, or undefined when no quota applies.
+ */
+export function readCgroupCpuQuotaCores(readFile: ReadOptionalFile): number | undefined {
+    return readCgroupCpuQuota(readFile)?.cores;
+}
+
+/**
+ * The percentage stays relative to one core when there is no quota or a quota of one core or more, because the event
+ * loop saturates at one core. A quota below one core lowers the reference: otherwise a process fully throttled at
+ * 0.65 CPU reports 65 % and never crosses the default threshold of 80.
+ */
+export function cpuCapacityCores(quotaCores: number | undefined): number {
+    return quotaCores === undefined ? 1 : Math.min(1, quotaCores);
+}
+
+/**
+ * Returns the reference capacity of the tracker and its source, from the cgroup CPU quota when one applies.
+ */
+export function readCpuCapacity(readFile: ReadOptionalFile): CpuCapacity {
+    const quota = readCgroupCpuQuota(readFile);
+    if (quota === undefined) {
+        return { cores: 1, source: "no cgroup CPU quota, one-core reference" };
+    }
+    return { cores: cpuCapacityCores(quota.cores), source: `${quota.source} (quota ${quota.cores} cores)` };
+}
+
+/**
+ * Reads a file, returning undefined when it does not exist. Other read failures are logged, then treated as absent.
+ */
+export function readOptionalFile(path: string): string | undefined {
+    try {
+        return readFileSync(path, "utf8");
+    } catch (e: unknown) {
+        const error = asError(e);
+        if (!("code" in error) || error.code !== "ENOENT") {
+            console.warn(`Cannot read ${path}, ignoring it for the CPU quota`, error);
+        }
+        return undefined;
+    }
+}
+
+export class CpuTracker {
+    private cpuPercent = 0;
+    private overHeating = false;
+    private readonly capacityCores: number;
+
+    constructor(capacity: CpuCapacity = readCpuCapacity(readOptionalFile)) {
+        if (!Number.isFinite(capacity.cores) || capacity.cores <= 0) {
+            throw new Error(`CPU capacity must be a positive number of cores, got ${capacity.cores}`);
+        }
+        this.capacityCores = capacity.cores;
+        console.info(`CPU tracker: percentages are relative to ${capacity.cores} core(s), from ${capacity.source}`);
+
+        let time = process.hrtime.bigint();
+        let usage = process.cpuUsage();
+        setInterval(() => {
+            const elapTime = process.hrtime.bigint();
+            const elapUsage = process.cpuUsage(usage);
+            usage = process.cpuUsage();
+
+            const elapTimeMS = Number(elapTime - time) / 1000000;
+            const elapUserMS = secNSec2ms(elapUsage.user);
+            const elapSystMS = secNSec2ms(elapUsage.system);
+            this.cpuPercent = Math.round((100 * (elapUserMS + elapSystMS)) / (elapTimeMS * this.capacityCores));
+
+            time = elapTime;
+
+            if (!this.overHeating && this.cpuPercent > CPU_OVERHEAT_THRESHOLD) {
+                this.overHeating = true;
+                console.warn('CPU high threshold alert. Going in "overheat" mode');
+            } else if (this.overHeating && this.cpuPercent <= CPU_OVERHEAT_THRESHOLD) {
+                this.overHeating = false;
+                console.info('CPU is back to normal. Canceling "overheat" mode');
+            }
+        }, 100);
+    }
+
+    public getCpuPercent(): number {
+        return this.cpuPercent;
+    }
+
+    public isOverHeating(): boolean {
+        return this.overHeating;
+    }
+}
diff --git a/back/tests/CpuTracker.test.ts b/back/tests/CpuTracker.test.ts
new file mode 100644
index 0000000..0472e19
--- /dev/null
+++ b/back/tests/CpuTracker.test.ts
@@ -0,0 +1,211 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import {
+    CpuTracker,
+    parseCgroupV1CfsQuota,
+    parseCgroupV2CpuMax,
+    parseCgroupV2Path,
+    readCgroupCpuQuotaCores,
+    readCpuCapacity,
+    readOptionalFile,
+} from "../src/Services/QuotaAwareCpuTracker";
+
+vi.mock("../src/Enum/EnvironmentVariable", () => ({ CPU_OVERHEAT_THRESHOLD: 80 }));
+
+const PROC_SELF_CGROUP = "/proc/self/cgroup";
+const V2_CPU_MAX = "/sys/fs/cgroup/cpu.max";
+const V1_QUOTA = "/sys/fs/cgroup/cpu/cpu.cfs_quota_us";
+const V1_PERIOD = "/sys/fs/cgroup/cpu/cpu.cfs_period_us";
+
+const fakeCgroup =
+    (files: Record<string, string>) =>
+    (path: string): string | undefined =>
+        files[path];
+
+// Synthetic clock: each 100 ms tick credits the process `coresUsed * 100 ms` of CPU time.
+function trackerConsuming(coresUsed: number, cgroupFiles: Record<string, string>): CpuTracker {
+    let nowNs = 0n;
+    let cpuUs = 0;
+    vi.spyOn(process.hrtime, "bigint").mockImplementation(() => nowNs);
+    vi.spyOn(process, "cpuUsage").mockImplementation((previous?: NodeJS.CpuUsage) =>
+        previous ? { user: cpuUs - previous.user, system: -previous.system } : { user: cpuUs, system: 0 },
+    );
+    vi.useFakeTimers({ toFake: ["setInterval"] });
+    const tracker = new CpuTracker(readCpuCapacity(fakeCgroup(cgroupFiles)));
+    for (let tick = 0; tick < 5; tick++) {
+        nowNs += 100_000_000n;
+        cpuUs += coresUsed * 100_000;
+        vi.advanceTimersByTime(100);
+    }
+    return tracker;
+}
+
+describe("CpuTracker", () => {
+    let warn: ReturnType<typeof vi.spyOn>;
+    let info: ReturnType<typeof vi.spyOn>;
+
+    beforeEach(() => {
+        warn = vi.spyOn(console, "warn").mockImplementation(() => undefined);
+        info = vi.spyOn(console, "info").mockImplementation(() => undefined);
+    });
+
+    afterEach(() => {
+        vi.useRealTimers();
+        vi.restoreAllMocks();
+    });
+
+    describe("parseCgroupV2CpuMax", () => {
+        it("should read a quota as cores", () => {
+            expect(parseCgroupV2CpuMax("65000 100000\n")).toBe(0.65);
+            expect(parseCgroupV2CpuMax("200000 100000")).toBe(2);
+        });
+
+        it("should treat max as unlimited", () => {
+            expect(parseCgroupV2CpuMax("max 100000\n")).toBeUndefined();
+        });
+
+        it("should reject malformed content", () => {
+            for (const content of ["", "garbage", "65000", "65000 100000 1", "abc 100000", "65000 0", "0 100000"]) {
+                expect(parseCgroupV2CpuMax(content), content).toBeUndefined();
+            }
+        });
+    });
+
+    describe("parseCgroupV1CfsQuota", () => {
+        it("should read a quota as cores", () => {
+            expect(parseCgroupV1CfsQuota("50000\n", "100000\n")).toBe(0.5);
+        });
+
+        it("should treat -1 as unlimited", () => {
+            expect(parseCgroupV1CfsQuota("-1\n", "100000\n")).toBeUndefined();
+        });
+
+        it("should reject malformed content", () => {
+            expect(parseCgroupV1CfsQuota("", "100000")).toBeUndefined();
+            expect(parseCgroupV1CfsQuota("abc", "100000")).toBeUndefined();
+            expect(parseCgroupV1CfsQuota("50000", "0")).toBeUndefined();
+            expect(parseCgroupV1CfsQuota("50000", "1e5")).toBeUndefined();
+        });
+    });
+
+    describe("parseCgroupV2Path", () => {
+        it("should read the cgroup v2 path of the process", () => {
+            expect(parseCgroupV2Path("0::/\n")).toBe("/");
+            expect(parseCgroupV2Path("12:cpu,cpuacct:/docker/abc\n0::/system.slice/wa.service\n")).toBe(
+                "/system.slice/wa.service",
+            );
+        });
+
+        it("should reject a missing entry or a path that is not plain absolute", () => {
+            expect(parseCgroupV2Path("12:cpu,cpuacct:/docker/abc\n")).toBeUndefined();
+            expect(parseCgroupV2Path("0::relative\n")).toBeUndefined();
+            expect(parseCgroupV2Path("0::/../../escape\n")).toBeUndefined();
+        });
+    });
+
+    describe("readCgroupCpuQuotaCores", () => {
+        it("should prefer cgroup v2 over cgroup v1", () => {
+            const quota = readCgroupCpuQuotaCores(
+                fakeCgroup({ [V2_CPU_MAX]: "65000 100000\n", [V1_QUOTA]: "200000\n", [V1_PERIOD]: "100000\n" }),
+            );
+            expect(quota).toBe(0.65);
+        });
+
+        it("should read cpu.max of the process cgroup from /proc/self/cgroup before the root", () => {
+            const files = {
+                [PROC_SELF_CGROUP]: "0::/system.slice/wa.service\n",
+                "/sys/fs/cgroup/system.slice/wa.service/cpu.max": "50000 100000\n",
+                [V2_CPU_MAX]: "max 100000\n",
+            };
+            expect(readCgroupCpuQuotaCores(fakeCgroup(files))).toBe(0.5);
+        });
+
+        it("should fall back to the root cpu.max when the process cgroup has none", () => {
+            const files = { [PROC_SELF_CGROUP]: "0::/system.slice/wa.service\n", [V2_CPU_MAX]: "65000 100000\n" };
+            expect(readCgroupCpuQuotaCores(fakeCgroup(files))).toBe(0.65);
+        });
+
+        it("should read cgroup v1 when cpu.max is absent", () => {
+            expect(readCgroupCpuQuotaCores(fakeCgroup({ [V1_QUOTA]: "50000\n", [V1_PERIOD]: "100000\n" }))).toBe(0.5);
+        });
+
+        it("should report no quota when the files are missing", () => {
+            expect(readCgroupCpuQuotaCores(fakeCgroup({}))).toBeUndefined();
+            expect(readCgroupCpuQuotaCores(fakeCgroup({ [V1_QUOTA]: "50000\n" }))).toBeUndefined();
+            expect(warn).not.toHaveBeenCalled();
+        });
+
+        it("should warn about malformed content but not about an unlimited quota", () => {
+            expect(readCgroupCpuQuotaCores(fakeCgroup({ [V2_CPU_MAX]: "max 100000\n" }))).toBeUndefined();
+            expect(
+                readCgroupCpuQuotaCores(fakeCgroup({ [V1_QUOTA]: "-1\n", [V1_PERIOD]: "100000\n" })),
+            ).toBeUndefined();
+            expect(warn).not.toHaveBeenCalled();
+
+            expect(readCgroupCpuQuotaCores(fakeCgroup({ [V2_CPU_MAX]: "garbage\n" }))).toBeUndefined();
+            expect(warn).toHaveBeenCalledWith(expect.stringContaining(V2_CPU_MAX));
+        });
+    });
+
+    describe("readOptionalFile", () => {
+        it("should return undefined for a missing file without logging", () => {
+            expect(readOptionalFile("/nonexistent/wa-cpu-tracker/cpu.max")).toBeUndefined();
+            expect(warn).not.toHaveBeenCalled();
+        });
+
+        it("should log a read failure other than a missing file", () => {
+            expect(readOptionalFile("/")).toBeUndefined();
+            expect(warn).toHaveBeenCalledWith(expect.stringContaining("Cannot read /"), expect.any(Error));
+        });
+    });
+
+    describe("getCpuPercent and isOverHeating", () => {
+        it("should overheat when the process fully consumes a 0.65-core cgroup v2 quota", () => {
+            const tracker = trackerConsuming(0.65, { [V2_CPU_MAX]: "65000 100000\n" });
+            expect(tracker.getCpuPercent()).toBe(100);
+            expect(tracker.isOverHeating()).toBe(true);
+            expect(info).toHaveBeenCalledWith(expect.stringMatching(/relative to 0\.65 core.*cgroup v2/));
+        });
+
+        it("should overheat when the process fully consumes a 0.5-core cgroup v1 quota", () => {
+            const tracker = trackerConsuming(0.5, { [V1_QUOTA]: "50000\n", [V1_PERIOD]: "100000\n" });
+            expect(tracker.getCpuPercent()).toBe(100);
+            expect(tracker.isOverHeating()).toBe(true);
+        });
+
+        it("should not overheat at 60 % of a 0.65-core quota", () => {
+            const tracker = trackerConsuming(0.39, { [V2_CPU_MAX]: "65000 100000\n" });
+            expect(tracker.getCpuPercent()).toBe(60);
+            expect(tracker.isOverHeating()).toBe(false);
+        });
+
+        it("should keep the one-core reference when the quota exceeds one core", () => {
+            const tracker = trackerConsuming(0.9, { [V2_CPU_MAX]: "200000 100000\n" });
+            expect(tracker.getCpuPercent()).toBe(90);
+            expect(tracker.isOverHeating()).toBe(true);
+        });
+
+        it("should keep the one-core reference when the quota is unlimited, missing or malformed", () => {
+            const cases: Record<string, string>[] = [
+                { [V2_CPU_MAX]: "max 100000\n" },
+                { [V1_QUOTA]: "-1\n", [V1_PERIOD]: "100000\n" },
+                {},
+                { [V2_CPU_MAX]: "garbage\n" },
+            ];
+            for (const cgroupFiles of cases) {
+                const tracker = trackerConsuming(0.65, cgroupFiles);
+                expect(tracker.getCpuPercent()).toBe(65);
+                expect(tracker.isOverHeating()).toBe(false);
+                vi.useRealTimers();
+            }
+            expect(info).toHaveBeenCalledWith(
+                expect.stringContaining("relative to 1 core(s), from no cgroup CPU quota"),
+            );
+        });
+
+        it("should reject a capacity that is not a positive number of cores", () => {
+            for (const cores of [0, -1, Number.NaN, Number.POSITIVE_INFINITY]) {
+                expect(() => new CpuTracker({ cores, source: "test" }), String(cores)).toThrow(/positive number/);
+            }
+        });
+    });
+});

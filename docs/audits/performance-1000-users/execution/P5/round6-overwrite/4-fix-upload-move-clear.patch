+    private async wamKeysDeletedByUpload(virtualDirectory: string, filesPathsFromZip: string[]): Promise<string[]> {
+        const wamPaths = await this.fileSystem.listFiles(virtualDirectory, ".wam");
+        return wamPaths
+            .filter(

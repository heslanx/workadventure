@@ -684,8 +684,19 @@
         releaseScrollAnchor();
         beginProgrammaticScroll("resync");
         target.scrollIntoView({ block: "center", behavior: "smooth" });
-        target.classList.remove("highlight-message");
-        target.classList.add("highlight-message");
+        highlightRow(target);
+    }
+
+    /** The pulse plays when the class is added, so the class goes when it ends and the next focus plays it again. */
+    function highlightRow(row: HTMLLIElement) {
+        const endHighlight = (event: AnimationEvent) => {
+            // An animation inside the message bubbles up here too; only the row's own is the pulse.
+            if (event.target !== row) return;
+            row.classList.remove("highlight-message");
+            row.removeEventListener("animationend", endHighlight);
+        };
+        row.addEventListener("animationend", endHighlight);
+        row.classList.add("highlight-message");
     }
 </script>
 

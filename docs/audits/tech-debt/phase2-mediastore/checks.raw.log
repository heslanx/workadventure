probe.ts sha256: 42b5bd9a2e1da7f2ef7d56dcde75bdcee487b1288053ca8cc5ed9e9d8263c1b6  probe.ts
type Plan = {
    mustRequestNewVideo: boolean;
    mustStopVideo: boolean;
} & ({ mustStopAudio: false; oldAudioConstraints: MediaTrackConstraints | false } | { mustStopAudio: true; oldAudioConstraints: MediaTrackConstraints });

function plan(old: { audio: MediaTrackConstraints | false }, next: { audio: MediaTrackConstraints | false }): Plan {
    const base = { mustRequestNewVideo: true, mustStopVideo: false };
    const oldAudioConstraints = old.audio;
    return oldAudioConstraints !== false && next.audio === false
        ? { ...base, mustStopAudio: true, oldAudioConstraints }
        : { ...base, mustStopAudio: false, oldAudioConstraints };
}
let warm: { constraints: MediaTrackConstraints } | undefined;
export function run(list: number[]): boolean {
    const { mustRequestNewVideo, mustStopVideo, mustStopAudio, oldAudioConstraints } = plan({ audio: {} }, { audio: false });
    if (mustStopAudio) {
        list.forEach(() => {
            warm = { constraints: oldAudioConstraints };
        });
    }
    return mustStopVideo && mustRequestNewVideo && warm !== undefined;
}
